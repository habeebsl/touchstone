# Server-side only. Deliberately NOT prefixed with VITE_: anything Vite sees as VITE_* is inlined
# into the built JavaScript, which is where this key used to sit, twice, readable by any visitor.
# Used by api/youcam/[...path].ts in production and by the youcamProxy plugin in dev.
YOUCAM_API_KEY=

# Camera Kit is a browser SDK and its credential is meant to be public — it runs client-side and
# is restricted by domain in the Perfect Corp console, not by secrecy. This must be the Camera Kit
# key, NOT the s2s key above.
VITE_YOUCAM_CAMERA_KIT_KEY=
VITE_YOUCAM_CAMERA_KIT_SECRET=
